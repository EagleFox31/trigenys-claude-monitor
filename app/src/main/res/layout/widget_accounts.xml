<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="TRIGENYS  •  CLAUDE MONITOR"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#E5EFFB"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="↻"
            android:textSize="22sp"
            android:contentDescription="Actualiser les quotas"
            android:textColor="#8DDFE5"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/account_name_1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Compte 1"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/account_usage_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 h — • 7 j —"
                android:textColor="#DCE7F5"
                android:textSize="11sp"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <ProgressBar
                android:id="@+id/session_bar_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="6dp"
                android:max="100"
                android:progressTint="#E4A43E"
                android:progressBackgroundTint="#384456"/>
            <Space
                android:layout_width="8dp"
                android:layout_height="1dp"/>
            <ProgressBar
                android:id="@+id/weekly_bar_1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="6dp"
                android:max="100"
                android:progressTint="#33B5B7"
                android:progressBackgroundTint="#384456"/>
        </LinearLayout>
        <TextView
            android:id="@+id/account_reset_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Non connecté"
            android:textColor="#9BA9BB"
            android:textSize="9sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="3dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#344154"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:layout_width="match_parent"
